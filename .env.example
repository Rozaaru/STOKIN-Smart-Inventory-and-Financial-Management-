# --- Supabase (atau PostgreSQL lain) ---
# Aplikasi: lewat pooler (port 6543, pgbouncer)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrasi: koneksi langsung / session pooler (port 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Untuk PostgreSQL lokal, isi keduanya dengan URL yang sama:
# DATABASE_URL="postgresql://user:password@localhost:5432/stokin"
# DIRECT_URL="postgresql://user:password@localhost:5432/stokin"

# Rahasia untuk menandatangani cookie sesi (min. 32 karakter acak)
# Buat dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Asisten AI (opsional; tanpa ini tombol "Analisis usaha saya" mengembalikan ringkasan angka saja)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"
